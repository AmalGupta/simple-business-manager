{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbm-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true, // keep the *.workers.dev fallback URL alive alongside the custom domain

  "vars": {
    "ENVIRONMENT": "development",
    "SARVAM_STT_MODE": "codemix",
    "SARVAM_LANGUAGE_CODE": "unknown",
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "ANTHROPIC_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "GOOGLE_DRIVE_CALLS_FOLDER_ID": "1BVvqN0a_e8mb4S50yMb9X-XwKEfxO5RR",
    "GOOGLE_DRIVE_ARCHIVE_FOLDER_ID": "12v7xURXHMtL20fjOVLEzmMmXdmcCYhXg",
    // Callers Directory (migration 0021): "Spam" subfolder inside Calls —
    // confirmed-spam Drive files move here instead of Archive.
    "GOOGLE_DRIVE_SPAM_FOLDER_ID": "130Xhaxx3Z0G5FgjxFOBIQ5e5FBaoute8",
    "PUBLIC_BASE_URL": "https://sbm-pipeline.gupta-amal01.workers.dev"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/upload", "/webhooks/*"]
  },

  // TEMPORARILY DISABLED — jainglass.dev is not yet a zone in this Cloudflare
  // account ([code: 10082] "Can't infer zone from route" on deploy). Add the
  // domain in the Cloudflare dashboard (Websites → Add a domain) and point
  // its nameservers there — only the account owner can do this — then
  // uncomment and redeploy. Cloudflare creates/manages the DNS record itself;
  // don't also add a manual CNAME. The *.workers.dev URL stays live either way.
  // "routes": [
  //   { "pattern": "sbm-pipeline.jainglass.dev", "custom_domain": true }
  // ],

  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "sbm-recordings-dev" },
    // Voice-note audio only (calls, site memos, checklist/complaint voice
    // notes, todo voice notes) — see docs/VOICE_NOTE_BUCKET_PLAN.md.
    // site_media (photos/videos) stays on RECORDINGS above. Bucket must be
    // created remotely (`wrangler r2 bucket create sbm-voice-notes-dev`)
    // before this can deploy — not done as part of this change.
    { "binding": "VOICE_NOTES", "bucket_name": "sbm-voice-notes-dev" }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "sbm-dev", "database_id": "7848e837-4051-4d32-9217-bb1d8535f641" }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Drive Calls-folder poller — only ingests when app_settings.drive_poll_enabled is on.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }

  // Subrequest budget for batch size is DRIVE_POLL_SUBREQUEST_BUDGET (default ~4 files
  // on Workers Free). Paid plans can raise it in vars and optionally add limits here.
  // out of scope — see the "Not in this milestone" list in docs/BUILD_BRIEF.md.
}
