# Local wrangler secrets — copy to .dev.vars (gitignored). See docs/SCAFFOLDING.md §3.
# Generate secrets: openssl rand -hex 32

# Shared secret gating POST /upload and /api/* — see docs/BUILD_BRIEF.md
# "No Cloudflare Access on this worker". GET /upload itself is unauthenticated
# (the worker injects this value server-side into the upload page's JS).
SBM_API_KEY=replace-with-openssl-rand-hex-32

# Required for local Sarvam submit (Task 3+). WEBHOOK_TOKEN is also sent as
# callback.auth_token — generate locally; does not need to match any cloud secret.
SARVAM_API_KEY=sk_your-sarvam-key-here
SARVAM_WEBHOOK_TOKEN=replace-with-openssl-rand-hex-32
# Extraction (Task 5). Optional if you only care about upload → R2 → D1.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Pepper mixed into every per-person PIN hash (src/lib/auth.ts) — makes a
# leaked D1 export (hashes + salts alone) insufficient to brute-force
# offline. Required before POST /api/admin/users will work.
PIN_PEPPER=replace-with-openssl-rand-hex-32

# AES-256-GCM key (base64, 32 raw bytes) letting admin/superadmin view a
# staff member's current PIN from the Staff page — see src/lib/auth.ts
# encryptPin/decryptPin. Deliberately separate from PIN_PEPPER, which stays
# one-way. Generate: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PIN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Google Drive service account (JWT → OAuth access token). Remote: wrangler
# secret put GOOGLE_DRIVE_CLIENT_EMAIL / GOOGLE_DRIVE_PRIVATE_KEY. Store only
# client_email + private_key — never commit the downloaded JSON key file.
# private_key may use literal \n for PEM newlines.
GOOGLE_DRIVE_CLIENT_EMAIL=sbm-drivesync@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Drive Calls folder + public origin for cron webhook callbacks (manual
# "Get latest" uses the request origin instead). Folder id is also in
# wrangler.jsonc vars; override here for local if needed.
GOOGLE_DRIVE_CALLS_FOLDER_ID=1BVvqN0a_e8mb4S50yMb9X-XwKEfxO5RR
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=12v7xURXHMtL20fjOVLEzmMmXdmcCYhXg
PUBLIC_BASE_URL=http://localhost:8787
